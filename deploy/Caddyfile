# API da demonstração (banco mock no próprio VPS)
api-demo.{$CLUBBY_DOMAIN} {
	encode gzip
	reverse_proxy api-demo:3000
}

# API de produção (Neon · main)
api.{$CLUBBY_DOMAIN} {
	encode gzip
	reverse_proxy api:3000
}

# Evolution API (WhatsApp) — QR e envio ficam por trás; o salão usa só o Clubby
evolution.{$CLUBBY_DOMAIN} {
	encode gzip
	reverse_proxy evolution-api:8080
}


# Copie para deploy/.env NO VPS e preencha. Nunca commite o arquivo real.

CLUBBY_DOMAIN=seudominio.com.br
CADDY_EMAIL=voce@seudominio.com.br

# Origens liberadas no CORS além das derivadas do domínio (demo./app./www.).
# Inclua a URL *.vercel.app de cada projeto para os previews funcionarem.
DEMO_CORS_ORIGINS=https://clubby-web-demo.vercel.app
PROD_CORS_ORIGINS=https://clubby-web.vercel.app

# Gere cada um com: openssl rand -base64 48
JWT_SECRET_DEMO=
JWT_SECRET_PROD=

SUPER_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=clubby-admin

# Produção: connection string do Neon, branch main, com pooler
DATABASE_URL_PROD=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Postgres isolado da demonstração (roda no próprio VPS)
POSTGRES_DEMO_PASSWORD=

# URLs públicas (OAuth do cliente + links nos e-mails)
API_PUBLIC_URL=https://api.seudominio.com.br
WEB_PUBLIC_URL=https://app.seudominio.com.br

# SMTP — obrigatório em produção (MFA da gestão + código de e-mail do cliente)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Clubby <noreply@seudominio.com.br>"

# WhatsApp / Meta (opcional no primeiro piloto)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v17.0

# Evolution no mesmo Lightsail (profile whatsapp)
# Gere a key: openssl rand -hex 24
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_SERVER_URL=https://evolution.clubby.com.br
# A API Clubby fala com a Evolution na rede Docker (mais estável que hairpin HTTPS)
EVOLUTION_API_URL=http://evolution-api:8080
WHATSAPP_INBOUND_URL=https://api.clubby.com.br/whatsapp/inbound

# Conversa do WhatsApp. A chave fica só no servidor.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Asaas (só se o clube online entrar no piloto — use URL de produção, não sandbox)
# ASAAS_API_KEY=
# ASAAS_API_URL=https://api.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=

# Copie para deploy/.env e ajuste. Nunca commite o arquivo real.

CLUBBY_DOMAIN=clubby.com.br
CADDY_EMAIL=voce@clubby.com.br

# URLs públicas usadas no build do Next.js
DEMO_API_PUBLIC_URL=https://api-demo.clubby.com.br
PROD_API_PUBLIC_URL=https://api.clubby.com.br

# Demo local (sem Caddy): deixe as URLs em localhost
# DEMO_API_PUBLIC_URL=http://localhost:3000

JWT_SECRET_DEMO=troque-esta-chave-demo
JWT_SECRET_PROD=troque-esta-chave-prod-com-64-chars

SUPER_ADMIN_PASSWORD=troque-a-senha-do-super-admin
DEMO_ADMIN_PASSWORD=clubby-admin

# Produção: connection string do Neon (ou Postgres gerenciado)
DATABASE_URL_PROD=postgresql://USER:SENHA@HOST/DB?sslmode=require

# Postgres isolado só da demonstração
POSTGRES_DEMO_PASSWORD=troque-a-senha-do-postgres-demo
